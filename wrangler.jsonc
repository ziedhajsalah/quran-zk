{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quran-zk",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2d291ff522d94474b68541e49e89ee4b",
      "localConnectionString": "postgresql://quran_dev:quran_local@127.0.0.1:55432/quran_dev"
    }
  ],
  "env": {
    "development": {
      "name": "quran-zk-dev",
      "vars": {
        "SITE_URL": "https://quran-zk-dev.ziedhajsalah.workers.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "d428e5b5be924fa9bb143d379c38a94d",
          "localConnectionString": "postgresql://quran_dev:quran_local@127.0.0.1:55432/quran_dev"
        }
      ],
      "routes": [],
      "workers_dev": true,
      "preview_urls": false
    }
  },
  "vars": {
    "SITE_URL": "https://quran-zk.tn"
  },
  "routes": [
    {
      "pattern": "quran-zk.tn",
      "custom_domain": true
    },
    {
      "pattern": "www.quran-zk.tn/*",
      "zone_name": "quran-zk.tn"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
